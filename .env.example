# Server-only PostgreSQL connection string. Never expose this with NEXT_PUBLIC_.
DATABASE_URL="postgresql://georgiano:replace-with-a-local-password@localhost:5432/georgiano?schema=public"

# Used only by the explicit one-time admin bootstrap command.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Optional. Required for persistent production media uploads through Vercel Blob.
BLOB_READ_WRITE_TOKEN=""
