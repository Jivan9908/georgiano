generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MenuItemStatus {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

enum HomepageSectionKey {
  HERO
  STORY
  WINE
  EXPERIENCE
  PRIVATE_DINING
  CONTACT
}

enum HomepageBlockType {
  TEXT
  FEATURE
  QUOTE
  MEDIA
  CTA
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  DECLINED
}

enum ContactInquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model MenuCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isVisible   Boolean    @default(true)
  items       MenuItem[]
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([isVisible, sortOrder])
}

model MenuItem {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String
  priceCents  Int?
  imageUrl    String?
  imageAlt    String?
  categoryId  String
  category    MenuCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status      MenuItemStatus       @default(AVAILABLE)
  featured    Boolean              @default(false)
  sortOrder   Int                  @default(0)
  dietaryTags MenuItemDietaryTag[]
  allergens   MenuItemAllergen[]
  orderItems  OrderItem[]
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  @@index([categoryId, status, sortOrder])
  @@index([featured, status])
}

model DietaryTag {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  items       MenuItemDietaryTag[]
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
}

model Allergen {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?
  items       MenuItemAllergen[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
}

model MenuItemDietaryTag {
  menuItemId   String
  dietaryTagId String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([menuItemId, dietaryTagId])
  @@index([dietaryTagId])
}

model MenuItemAllergen {
  menuItemId String
  allergenId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([menuItemId, allergenId])
  @@index([allergenId])
}

model HomepageContent {
  id          String            @id @default(cuid())
  name        String            @unique @default("primary")
  isPublished Boolean           @default(false)
  sections    HomepageSection[]
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
}

model HomepageSection {
  id                String             @id @default(cuid())
  homepageContentId String
  homepageContent   HomepageContent    @relation(fields: [homepageContentId], references: [id], onDelete: Cascade)
  key               HomepageSectionKey
  eyebrow           String?
  headline          String?
  supportingText    String?
  mediaType         MediaType?
  mediaUrl          String?
  mediaAlt          String?
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  sortOrder         Int                @default(0)
  isVisible         Boolean            @default(true)
  blocks            HomepageBlock[]
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([homepageContentId, key])
  @@index([homepageContentId, isVisible, sortOrder])
}

model HomepageBlock {
  id                String            @id @default(cuid())
  homepageSectionId String
  homepageSection   HomepageSection   @relation(fields: [homepageSectionId], references: [id], onDelete: Cascade)
  type              HomepageBlockType
  eyebrow           String?
  title             String?
  body              String?
  mediaUrl          String?
  mediaAlt          String?
  linkLabel         String?
  linkHref          String?
  sortOrder         Int               @default(0)
  isVisible         Boolean           @default(true)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  @@index([homepageSectionId, isVisible, sortOrder])
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  altText   String
  caption   String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isVisible, sortOrder])
}

model RestaurantSettings {
  id                     String                  @id @default(cuid())
  key                    String                  @unique @default("primary")
  restaurantName         String
  addressLine1           String?
  addressLine2           String?
  city                   String?
  state                  String?
  postalCode             String?
  phone                  String?
  email                  String?
  timezone               String                  @default("America/Los_Angeles")
  instagramUrl           String?
  facebookUrl            String?
  directionsUrl          String?
  orderingEnabled        Boolean                 @default(false)
  reservationSettings    ReservationSettings?
  businessServiceWindows BusinessServiceWindow[]
  specialBusinessHours   SpecialBusinessHours[]
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
}

model BusinessServiceWindow {
  id                   String             @id @default(cuid())
  restaurantSettingsId String
  restaurantSettings   RestaurantSettings @relation(fields: [restaurantSettingsId], references: [id], onDelete: Cascade)
  dayOfWeek            DayOfWeek
  label                String?
  startMinute          Int
  endMinute            Int
  sortOrder            Int                @default(0)
  isVisible            Boolean            @default(true)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  @@index([restaurantSettingsId, dayOfWeek, sortOrder])
}

model SpecialBusinessHours {
  id                   String             @id @default(cuid())
  restaurantSettingsId String
  restaurantSettings   RestaurantSettings @relation(fields: [restaurantSettingsId], references: [id], onDelete: Cascade)
  localDate            DateTime           @db.Date
  isClosed             Boolean            @default(false)
  label                String?
  startMinute          Int?
  endMinute            Int?
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([restaurantSettingsId, localDate])
}

model ReservationSettings {
  id                         String                     @id @default(cuid())
  restaurantSettingsId       String                     @unique
  restaurantSettings         RestaurantSettings         @relation(fields: [restaurantSettingsId], references: [id], onDelete: Cascade)
  enabled                    Boolean                    @default(false)
  minimumLeadTimeMinutes     Int?
  maximumAdvanceDays         Int?
  maximumPartySize           Int?
  reservationIntervalMinutes Int?
  defaultDurationMinutes     Int?
  serviceWindows             ReservationServiceWindow[]
  closures                   ReservationClosure[]
  capacityRules              ReservationCapacityRule[]
  createdAt                  DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                   @updatedAt @db.Timestamptz(3)
}

model ReservationServiceWindow {
  id                     String              @id @default(cuid())
  reservationSettingsId  String
  reservationSettings    ReservationSettings @relation(fields: [reservationSettingsId], references: [id], onDelete: Cascade)
  dayOfWeek              DayOfWeek
  label                  String?
  startMinute            Int
  endMinute              Int
  slotIntervalMinutes    Int?
  defaultDurationMinutes Int?
  isEnabled              Boolean             @default(true)
  sortOrder              Int                 @default(0)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)

  @@index([reservationSettingsId, dayOfWeek, sortOrder])
}

model ReservationClosure {
  id                    String              @id @default(cuid())
  reservationSettingsId String
  reservationSettings   ReservationSettings @relation(fields: [reservationSettingsId], references: [id], onDelete: Cascade)
  startDate             DateTime            @db.Date
  endDate               DateTime            @db.Date
  startMinute           Int?
  endMinute             Int?
  reason                String?
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  @@index([reservationSettingsId, startDate, endDate])
}

model ReservationCapacityRule {
  id                    String              @id @default(cuid())
  reservationSettingsId String
  reservationSettings   ReservationSettings @relation(fields: [reservationSettingsId], references: [id], onDelete: Cascade)
  dayOfWeek             DayOfWeek?
  startMinute           Int?
  endMinute             Int?
  maximumCovers         Int
  effectiveFrom         DateTime?           @db.Date
  effectiveUntil        DateTime?           @db.Date
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  @@index([reservationSettingsId, dayOfWeek])
}

model Reservation {
  id              String            @id @default(cuid())
  guestName       String
  email           String
  phone           String
  partySize       Int
  reservationAt   DateTime          @db.Timestamptz(3)
  timezone        String            @default("America/Los_Angeles")
  specialOccasion String?
  specialRequests String?
  status          ReservationStatus @default(PENDING)
  internalNotes   String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  @@index([reservationAt, status])
  @@index([email])
}

model PrivateDiningInquiry {
  id            String        @id @default(cuid())
  fullName      String
  email         String
  phone         String
  eventType     String
  preferredDate DateTime?     @db.Date
  guestCount    Int?
  eventDetails  String?
  status        InquiryStatus @default(NEW)
  internalNotes String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([email])
}

model ContactInquiry {
  id            String               @id @default(cuid())
  name          String
  email         String
  phone         String?
  subject       String
  message       String
  status        ContactInquiryStatus @default(NEW)
  internalNotes String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([email])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  customerEmail String
  customerPhone String
  pickupAt      DateTime    @db.Timestamptz(3)
  timezone      String      @default("America/Los_Angeles")
  status        OrderStatus @default(NEW)
  subtotalCents Int
  taxCents      Int
  totalCents    Int
  notes         String?
  items         OrderItem[]
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  @@index([pickupAt, status])
  @@index([customerEmail])
}

model OrderItem {
  id                     String    @id @default(cuid())
  orderId                String
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId             String?
  menuItem               MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemNameSnapshot       String
  itemPriceCentsSnapshot Int
  quantity               Int
  lineTotalCents         Int
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@index([menuItemId])
}

model AuditLog {
  id              String     @id @default(cuid())
  actorIdentifier String?
  actorUserId     String?
  actorUser       AdminUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action          String
  entityType      String
  entityId        String?
  metadata        Json?
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorIdentifier, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?      @db.Timestamptz(3)
  sessions     AdminSession[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  @@index([isActive])
}

model AdminSession {
  id         String    @id @default(cuid())
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipHash    String
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}
